# Copy to ~/.config/ha-kit.env, edit, and chmod 600 it. Never commit the real file.
# Every script in this kit reads this one file (override the path with HA_KIT_ENV=/other/file).

# Home Assistant, as reached FROM the server running these scripts.
HA_URL=https://homeassistant.example.ts.net
# A long-lived access token (HA profile page > Security). File holds only the token. chmod 600.
HA_TOKEN_FILE=$HOME/.config/ha-token
# The notify service for your phone, from the HA mobile app (Developer tools > Actions > "notify.").
HA_NOTIFY=notify.mobile_app_your_phone

# Email: the channel that does NOT go through Home Assistant (used when HA itself is down).
# Any SMTP account works. iCloud: smtp.mail.me.com:587 with an app-specific password.
# Gmail: smtp.gmail.com:587 with an app password.
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS_FILE=$HOME/.config/smtp-pass
ALERT_TO=you@example.com

# Where scripts keep small state files and logs.
STATE_DIR=$HOME/.local/state/ha-kit
# Folder this kit is installed in (scripts call each other through it).
KIT_DIR=$HOME/ha-community-kit
